# Copy to .env at repository root. Never commit credentials.
# The gateway defaults to loopback port 3000; only tunnel this port.
PORT=3000
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=matthew
# AWS uses the standard SDK credential chain (e.g. AWS_PROFILE after aws sso login).
# AWS_PROFILE=
ABE_BACKEND_URL=http://127.0.0.1:8000
# Generate a random value of at least 32 characters; both processes use this.
ABE_INTERNAL_TOKEN=

# Milestone 2: local synthetic modes need no additional AWS services.
MEMBER_REPOSITORY=synthetic
# Only required when MEMBER_REPOSITORY=dynamodb; existing table, never provisioned here.
DYNAMODB_MEMBER_TABLE=
RAG_PROVIDER=local
# Only required when RAG_PROVIDER=bedrock; existing KB with matching metadata.
BEDROCK_KNOWLEDGE_BASE_ID=
# Never put AWS access keys in this file; use the standard credential chain.

# Companion app: a separate random key, at least 32 characters.
# Enter this key in the app locally. NEVER use ABE_INTERNAL_TOKEN in the browser.
ABE_MEMBER_TOKEN=
# Persistent local conversations; no AWS storage resources needed.
CONVERSATION_REPOSITORY=sqlite
ABE_CONVERSATION_DB=.local/abe-conversations.sqlite3
# Bedrock Converse model/inference profile accessible to your AWS identity.
NOVA_TEXT_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Optional: your existing Twilio number in E.164 format (e.g. +1...)
ABE_DEMO_CALL_NUMBER=

# Milestone 3: read existing resources only; tests keep local adapters.
PLAN_RULES_SOURCE=local
PROVIDER_REPOSITORY=synthetic
HISTORY_REPOSITORY=synthetic
# Required when corresponding mode is dynamodb.
DYNAMODB_PLAN_TABLE=abe-plans
DYNAMODB_COVERAGE_RULE_TABLE=abe-coverage-rules
DYNAMODB_PROCEDURE_TABLE=abe-procedures
DYNAMODB_PROVIDER_TABLE=abe-providers
DYNAMODB_CLAIM_TABLE=abe-claims
DYNAMODB_AUTHORIZATION_TABLE=abe-authorizations
# Optional manifest for verified S3 source-to-plan mapping without metadata sidecars.
RAG_DOCUMENT_MANIFEST_S3_URI=
# RAG_PROVIDER=disabled explicitly reports unavailable evidence when no KB exists.

# Existing managed RAG demo (keep local defaults above for offline tests):
# RAG_PROVIDER=bedrock
# BEDROCK_KNOWLEDGE_BASE_ID=3IVSARFSID
# RAG_DOCUMENT_MANIFEST_S3_URI=s3://abe-rag-517355425116-us-east-1/rag/metadata/documents.json
# The manifest bucket must match the KB source; metadata sidecars are not required.
