# Copy to .env at repository root. Never commit credentials.
# The gateway defaults to loopback port 3000; only tunnel this port.
PORT=3000
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AWS_REGION=us-east-1
NOVA_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_VOICE_ID=tiffany
# AWS uses the standard SDK credential chain (e.g. AWS_PROFILE after aws sso login).
# AWS_PROFILE=
ABE_BACKEND_URL=http://127.0.0.1:8000
# Generate a random value of at least 32 characters; both processes use this.
ABE_INTERNAL_TOKEN=

# Milestone 2: local synthetic modes need no additional AWS services.
MEMBER_REPOSITORY=synthetic
# Only required when MEMBER_REPOSITORY=dynamodb; existing table, never provisioned here.
DYNAMODB_MEMBER_TABLE=
RAG_PROVIDER=local
# Only required when RAG_PROVIDER=bedrock; existing KB with matching metadata.
BEDROCK_KNOWLEDGE_BASE_ID=
# Never put AWS access keys in this file; use the standard credential chain.
